<?xml version="1.0"?>
<!-- Points editors/validators at the ROS2 package.xml format 3 schema. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Root element: declares this directory as a ROS2 package using format 3. -->
<package format="3">
  <!-- This package's name, as referenced by ros2 run/launch and other packages' dependencies. -->
  <name>maze_interfaces</name>
  <!-- Package version. -->
  <version>0.1.0</version>
  <!-- Human-readable summary of what this package does. -->
  <description>Action interfaces used across the maze-solving stack: SolveMaze (referee -> control_node) and TraceMaze (control_node -> motion_executor)</description>
  <!-- Package maintainer, with contact email. -->
  <maintainer email="bshah43@asu.edu">Bhavya Shah</maintainer>
  <!-- License this package is distributed under. -->
  <license>Apache 2.0</license>

  <!-- This is an ament_cmake package. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Needed at build time to generate the SolveMaze/TraceMaze actions' bindings. -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Needed at runtime by anything using the generated SolveMaze/TraceMaze bindings. -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- Provides nav_msgs/Path, used as TraceMaze's goal field type. -->
  <depend>nav_msgs</depend>

  <!-- Marks this as an interface-only package, for tooling that treats those specially. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ament's automatic lint-test discovery. -->
  <test_depend>ament_lint_auto</test_depend>
  <!-- The standard set of ament lint checks. -->
  <test_depend>ament_lint_common</test_depend>

  <!-- ament-specific package metadata. -->
  <export>
    <!-- Declares this package's build type to the ament build system. -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
