<?xml version="1.0"?>
<!-- Points editors/validators at the ROS2 package.xml format 3 schema. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Root element: declares this directory as a ROS2 package using format 3. -->
<package format="3">
  <!-- This package's name, as referenced by ros2 run/launch and other packages' dependencies. -->
  <name>maze_gazebo</name>
  <!-- Package version. -->
  <version>0.1.0</version>
  <!-- Human-readable summary of what this package does. -->
  <description>Sim-only: Gazebo world, overhead camera model, maze wall generation, and the referee node that drives the solve/reset loop against maze_solver's SolveMaze action</description>
  <!-- Package maintainer, with contact email. -->
  <maintainer email="bshah43@asu.edu">Bhavya Shah</maintainer>
  <!-- License this package is distributed under. -->
  <license>Apache 2.0</license>

  <!-- This is an ament_cmake package, since it has a build-time mesh-conversion step. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- NumPy is only needed at build time, by the mesh-conversion script. -->
  <build_depend>python3-numpy</build_depend>
  <!-- Supplies the RealSense D435's official DAE mesh, converted at build time. -->
  <depend>realsense2_description</depend>

  <!-- Provides the SolveMaze action this package's referee node calls. -->
  <exec_depend>maze_interfaces</exec_depend>
  <!-- Launches and spawns entities into Gazebo. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- Bridges Gazebo topics onto ROS2 topics. -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- Publishes the overhead camera's static transform. -->
  <exec_depend>tf2_ros</exec_depend>
  <!-- Core ROS2 Python client library, used by the referee node. -->
  <exec_depend>rclpy</exec_depend>
  <!-- Used to resolve this package's own share directory at runtime. -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- YAML parsing for scene.yaml. -->
  <exec_depend>python3-yaml</exec_depend>
  <!-- mazelib has no rosdep key; installed via pip with the system's externally managed override flag -->
  <!-- Maze-generation library used by the referee node. -->
  <exec_depend>mazelib</exec_depend>

  <!-- ament's automatic lint-test discovery. -->
  <test_depend>ament_lint_auto</test_depend>
  <!-- The standard set of ament lint checks. -->
  <test_depend>ament_lint_common</test_depend>

  <!-- ament-specific package metadata. -->
  <export>
    <!-- Declares this package's build type to the ament build system. -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
