<?xml version="1.0"?>
<!-- Root element: declares this directory as a Gazebo model. -->
<model>
  <!-- The model's name, as referenced when spawning it. -->
  <name>overhead_camera</name>
  <!-- Model version. -->
  <version>1.0</version>
  <!-- Points at this model's actual SDF definition file. -->
  <sdf version="1.9">model.sdf</sdf>

  <!-- Model author metadata. -->
  <author>
    <!-- Author's name. -->
    <name>Bhavya Shah</name>
    <!-- Author's contact email. -->
    <email>bshah43@asu.edu</email>
  </author>

  <!-- Human-readable description shown by Gazebo's model browser. -->
  <description>
    A fixed RGB-D camera mounted overhead, facing straight down at the floor,
    for observing the Franka robot workspace from above in Gazebo simulation.
  </description>
</model>
