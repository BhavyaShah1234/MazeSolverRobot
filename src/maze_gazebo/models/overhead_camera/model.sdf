<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="overhead_camera">
    <!--
      Fixed overhead camera, meant to be centered above the maze and pitched
      90 degrees so its optical axis (local +X) points straight down the
      world -Z axis at the floor.

      No <pose> here: this model is always spawned via `ros_gz_sim create`
      (see franka_with_overhead_camera.launch.py), whose -x/-y/-z/-R/-P/-Y
      arguments unconditionally override any pose set here, even when left
      at their default of 0: verified empirically by spawning this file
      with no pose flags and observing it land at the origin with identity
      orientation. The actual mount pose, and the FR3-forward-kinematics
      derivation of its height, live in config/camera_and_maze.yaml (read by
      that launch file) instead.
    -->
    <static>true</static>

    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <!--
        Intel's official RealSense D435 mesh (realsense2_description,
        Apache-2.0). meshes/d435.stl is generated at build time from that
        package's d435.dae by scripts/convert_realsense_mesh.py (see
        CMakeLists.txt): identical triangles, with facet normals added, since
        the DAE has none and Gazebo renders a mesh without normals as a flat
        white silhouette.

        Placed exactly as Intel's own _d435.urdf.xacro does it: this link is the
        camera_link frame (x forward, y left, z up) with the depth imager at its
        origin (where the sensor below sits), and the mesh, whose own origin
        is on the front plate between the two infrared imagers, offset 17.5 mm
        off that and rotated (90 deg, 0, 90 deg) into this frame's convention.

        The material is Intel's own "aluminum" grey. Ambient and diffuse must
        both be set and specular left at zero: with a diffuse-only or
        non-zero-specular material this dense mesh blows out to pure white.
      -->
      <visual name="visual">
        <pose>0.0043 -0.0175 0 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>meshes/d435.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <sensor name="overhead_rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>overhead_camera</topic>
      </sensor>
    </link>
  </model>
</sdf>
